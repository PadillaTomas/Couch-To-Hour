    "onboarding.mode.eyebrow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome" } } } },
    "onboarding.mode.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How do you want to run this?" } } } },
    "onboarding.mode.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You can change this later in Settings." } } } },
    "onboarding.mode.threeDayTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "3-Day Plan" } } } },
    "onboarding.mode.threeDayBody" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Three sessions a week on set days, a rest day between each. We fill in your calendar." } } } },
    "onboarding.mode.freeTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Free Run" } } } },
    "onboarding.mode.freeBody" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Work through the weeks at your own pace. No schedule, no calendar." } } } },

    "onboarding.startingWeek.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Where do you want to start?" } } } },
    "onboarding.startingWeek.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Week 1 assumes you're starting from scratch. Skip ahead if you already run." } } } },
    "onboarding.startingWeek.weekLabel" : { "extractionState" : "manual", "comment" : "%lld is the week number, 1–6", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Week %lld" } } } },
    "onboarding.startingWeek.blurb1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One-minute run / walk intervals." } } } },
    "onboarding.startingWeek.blurb2" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Runs up to five minutes." } } } },
    "onboarding.startingWeek.blurb3" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ten-minute run blocks." } } } },
    "onboarding.startingWeek.blurb4" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Fifteen-minute run blocks." } } } },
    "onboarding.startingWeek.blurb5" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A 20–30 min run, plus warm-up." } } } },
    "onboarding.startingWeek.blurb6" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Up to a 50-minute continuous run." } } } },

    "onboarding.startWeekday.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Which day does your week start?" } } } },
    "onboarding.startWeekday.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sessions land on this day and every second day after, resetting each week." } } } },

    "onboarding.philosophy.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This isn't a race." } } } },
    "onboarding.philosophy.body1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run at a pace where you could still hold a conversation. If you can't, slow down — that's the whole method, not a failure." } } } },
    "onboarding.philosophy.body2" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The plan measures time spent running, never distance or speed. Miss a day and nothing breaks; the app just asks what you want to do next." } } } },

