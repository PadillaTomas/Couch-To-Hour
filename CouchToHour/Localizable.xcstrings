    "onboarding.mode.threeDayBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three sessions a week on set days, a rest day between each. We fill in your calendar."
          }
        }
      }
    },
